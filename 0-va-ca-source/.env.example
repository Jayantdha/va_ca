# Copy to an untracked .env locally; never commit real secrets.
NODE_ENV=production
SECRET=                 # 32+ random characters (generate one, keep it forever)
ORIGINS=                # website address(es), comma separated, e.g. https://va-ca.vercel.app
DB_PATH=va_ca.db        # Local SQLite file; ignored when DATABASE_URL is set
DATABASE_URL=           # Supabase Postgres Session Pooler URL (IPv4); used by the hosted API
SUPABASE_URL=            # Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # Server-only key; never put this in the frontend
SUPABASE_STORAGE_BUCKET=va-ca-photos
# Rate limits remain in memory; REDIS_URL is not wired up.
REDIS_URL=
MSG91_AUTH_KEY=         # MSG91 dashboard > Authkey
MSG91_TEMPLATE_ID=      # DLT-approved OTP template id (must contain the OTP variable)
MSG91_VAR=OTP           # the variable name used in that template
TURNSTILE_SECRET=       # Cloudflare Turnstile secret key
RAZORPAY_KEY_ID=        # start with TEST keys (rzp_test_...)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET= # 16+ chars, the same value you type in Razorpay > Webhooks
PRICE_PAISE=49900       # price in paise (49900 = Rs 499)
WEBHOOK_SECRET=         # legacy alias; set same as RAZORPAY_WEBHOOK_SECRET if needed for older setups
